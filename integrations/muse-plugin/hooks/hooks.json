{
  "description": "Native Traceary lifecycle hooks for Muse Code.",
  "hooks": {
    "SessionStart": [{"hooks": [{"name": "traceary-session-start", "type": "command", "command": "\"${MUSE_PLUGIN_ROOT}/scripts/traceary-muse.sh\" \"session-start\"", "timeout": 10}]}],
    "UserPromptSubmit": [{"hooks": [{"name": "traceary-prompt", "type": "command", "command": "\"${MUSE_PLUGIN_ROOT}/scripts/traceary-muse.sh\" \"user-prompt-submit\"", "timeout": 10}]}],
    "PreToolUse": [{"hooks": [{"name": "traceary-tool-pre", "type": "command", "command": "\"${MUSE_PLUGIN_ROOT}/scripts/traceary-muse.sh\" \"pre-tool-use\"", "timeout": 10}]}],
    "PostToolUse": [{"hooks": [{"name": "traceary-audit", "type": "command", "command": "\"${MUSE_PLUGIN_ROOT}/scripts/traceary-muse.sh\" \"post-tool-use\"", "timeout": 10}]}],
    "PostToolUseFailure": [{"hooks": [{"name": "traceary-audit-failure", "type": "command", "command": "\"${MUSE_PLUGIN_ROOT}/scripts/traceary-muse.sh\" \"post-tool-use-failure\"", "timeout": 10}]}],
    "Stop": [{"hooks": [{"name": "traceary-stop", "type": "command", "command": "\"${MUSE_PLUGIN_ROOT}/scripts/traceary-muse.sh\" \"stop\"", "timeout": 10}]}],
    "PreCompact": [{"hooks": [{"name": "traceary-compact-pre", "type": "command", "command": "\"${MUSE_PLUGIN_ROOT}/scripts/traceary-muse.sh\" \"pre-compact\"", "timeout": 10}]}],
    "PostCompact": [{"hooks": [{"name": "traceary-compact-post", "type": "command", "command": "\"${MUSE_PLUGIN_ROOT}/scripts/traceary-muse.sh\" \"post-compact\"", "timeout": 10}]}]
  }
}
