{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traceary.dev/schemas/capacity-baseline-v1.json",
  "title": "Traceary sanitized capacity baseline",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "capacity", "benchmark"],
  "properties": {
    "schema_version": { "const": "traceary.capacity-baseline/v1" },
    "capacity": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "database_bytes", "free_pages", "wal_bytes", "evidence"],
      "properties": {
        "schema_version": { "const": "traceary.capacity/v1" },
        "database_bytes": { "type": "integer", "minimum": 22710475178, "maximum": 23247346058 },
        "free_pages": { "type": "integer", "minimum": 0 },
        "wal_bytes": { "type": "integer", "minimum": 0 },
        "evidence": { "type": "object", "additionalProperties": false, "required": ["status"], "properties": { "status": { "enum": ["complete", "unavailable"] } } }
      }
    },
    "benchmark": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "status", "fixture", "iterations", "cases"],
      "properties": {
        "schema_version": { "const": "traceary.store-benchmark/v1" },
        "status": { "enum": ["passed", "timeout"] },
        "fixture": { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "copied_store" } } },
        "iterations": { "type": "integer", "minimum": 1 },
        "cases": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/$defs/case" } }
      }
    }
  },
  "$defs": {
    "case": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "status", "query_plan"],
      "properties": {
        "name": { "enum": ["active", "latest", "handoff", "search"] },
        "status": { "enum": ["passed", "timeout"] },
        "timeout_ms": { "type": "integer", "minimum": 1 },
        "elapsed_lower_bound_us": { "type": "integer", "minimum": 1 },
        "matched_rows": { "type": "integer", "minimum": 0 },
        "cold_p50_us": { "type": "integer", "minimum": 1 }, "cold_p95_us": { "type": "integer", "minimum": 1 },
        "warm_p50_us": { "type": "integer", "minimum": 1 }, "warm_p95_us": { "type": "integer", "minimum": 1 },
        "query_plan": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      },
      "allOf": [
        { "if": { "properties": { "status": { "const": "timeout" } } }, "then": { "required": ["timeout_ms", "elapsed_lower_bound_us"] } },
        { "if": { "properties": { "status": { "const": "passed" } } }, "then": { "required": ["cold_p50_us", "cold_p95_us", "warm_p50_us", "warm_p95_us"] } },
        { "if": { "properties": { "name": { "const": "search" }, "status": { "const": "passed" } }, "then": { "required": ["matched_rows"] } }
      ]
    }
  }
}
